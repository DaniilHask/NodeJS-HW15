    "next": "^16.4.0",
    "nodemon": "^3.1.14",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.23.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "ts-node": "^10.9.2",
    "typeorm": "^1.1.2",
    "winston": "^3.19.0"
  },
  "devDependencies": {
